#!/bin/sh
# Enable 32-bit Wine in the amd64 Live rootfs. Never run this on the build host.
set -eu
[ "$(dpkg --print-architecture)" = amd64 ] || exit 0

dpkg --add-architecture i386
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    wine32:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386 libvulkan1:i386 mesa-vulkan-drivers:i386
# Fail the ISO build rather than silently ship a 64-bit-only runtime.
dpkg-query -W -f='${Status}\n' wine32:i386 | grep -qx 'install ok installed'
