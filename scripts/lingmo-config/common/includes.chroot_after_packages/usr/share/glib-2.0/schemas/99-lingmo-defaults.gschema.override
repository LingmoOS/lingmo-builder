# Lingmo OS 系统默认值（gschema override）
#
# 图标主题必须是 lingmo（值是 /usr/share/icons 下的目录名，不是 index.theme 里的 Name）：三个 schema 各管一段——DDE 控制中心/桌面读
# com.deepin.dde.appearance，GTK 应用与桌面读
# com.deepin.wrap.gnome.desktop.interface，XSettings 读 com.deepin.xsettings。
# 只在 velora-desktop-schemas 里改 schema 默认值不够稳妥（已安装系统里若已有
# dconf 值就会覆盖默认值），所以在镜像里再放一份 override，并在构建时重编译
# schema，保证 live 会话与新装系统开箱即是 Lingmo 图标，无需手动在控制中心点选。
[com.deepin.dde.appearance]
icon-theme='lingmo'

[com.deepin.xsettings]
icon-theme-name='lingmo'

[com.deepin.wrap.gnome.desktop.interface]
icon-theme='lingmo'
