#!/bin/sh
# Boot-time Live detection, not a marker copied into the installed filesystem.
grep -Eq '(^|[[:space:]])boot=live([[:space:]]|$)' /proc/cmdline || exit 0
[ -x /usr/bin/lingmo-installer-config ] || exit 0
# Avoid concurrent launches when several autostart dispatchers run.
[ -n "${XDG_RUNTIME_DIR:-}" ] || exit 0
exec 9>"$XDG_RUNTIME_DIR/lingmo-live-installer.lock"
flock -n 9 || exit 0
exec /usr/bin/lingmo-installer-config
